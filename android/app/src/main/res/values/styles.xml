<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#F4F6F5</color>
    <color name="forest">#0F2A1F</color>
    <color name="green">#0A8A55</color>
    <color name="ink">#0F1A15</color>
    <color name="muted">#7C8A83</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:colorPrimary">@color/green</item>
    </style>
</resources>
